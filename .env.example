# ── Luz & Cia · variáveis de ambiente ──────────────────────────────
# Copie para .env e ajuste.

# Banco de dados
# Local: SQLite (padrão, já configurado)
# Vercel/Neon/Supabase: troque o provider no prisma/schema.prisma para
# "postgresql" e use uma URL no formato:
#   postgresql://usuario:senha@host/db?sslmode=require
DATABASE_URL="file:../db/custom.db"

# Segredo das sessões do painel /admin (HMAC)
# Gere com: openssl rand -hex 32
AUTH_SECRET=""

# URL pública de produção — usada em canonical, Open Graph, sitemap.xml
# e robots.txt. Na Vercel, defina com o domínio real (ex.: https://www.luzecia.net).
# Em dev, deixe o default do código (https://www.luzecia.net).
NEXT_PUBLIC_SITE_URL=""

# ── Google Search Console ──────────────────────────────────────────
# Verificação por tag meta: no Search Console escolha "Tag HTML" e cole
# aqui SOMENTE o valor do content="...". Deixe vazio para verificar por DNS.
GOOGLE_SITE_VERIFICATION=""

# ── Google Analytics 4 ─────────────────────────────────────────────
# ID de medição do GA4 (Administrador → Fluxos de dados → G-XXXXXXXXXX).
# Vazio = nenhum script carregado (zero custo de performance).
NEXT_PUBLIC_GA_ID=""

# ── Google Tag Manager ─────────────────────────────────────────────
# ID do contêiner GTM (GTM-XXXXXXX). Se usar GTM, o GA4 pode ser
# instalado por dentro dele — nesse caso deixe NEXT_PUBLIC_GA_ID vazio.
NEXT_PUBLIC_GTM_ID=""
