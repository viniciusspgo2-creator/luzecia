  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "6.16.3",
    "typescript": "^5"
  }
}
