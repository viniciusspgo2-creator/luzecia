{
  "name": "luz-cia-site",
  "version": "4.1.0",
  "private": true,
  "description": "Luz & Cia — site institucional (migração PHP → Next.js 16)",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
